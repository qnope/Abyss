msgstr "Turn {turn}: {wave} against {defenders, plural, =0{no defender} =1{1 defender} other{{defenders} defenders}}"

msgid "defeatAdviceRaiseAnArmy"
msgstr "Your base was empty. Build the Barracks and recruit Harpooners as soon as a raid is announced."

msgid "defeatAdviceMoreDefenders"
msgstr "Against your last raid, it took about {needed} Harpooners. You had {defenders, plural, =0{no defender} =1{1 defender} other{{defenders} defenders}}."

msgid "defeatAdviceTooStrong"
msgstr "Your last raid called for more than {max} Harpooners: keep the noise gauge lower and raise the Citadel's rampart."

msgid "defeatAdviceWrongUnits"
msgstr "You had enough defenders, but not the right ones."

msgid "openingStorySettings"
msgstr "The story of the game"

msgid "openingStorySkip"
msgstr "Skip"

msgid "openingStoryDive"
msgstr "Dive in"

msgid "openingSinkingTitle"
msgstr "The Great Sinking"

msgid "openingSinkingLine1"
msgstr "The world above has become unlivable. The last ships sank their domes down to the reef, where daylight still reaches."

msgid "openingSinkingLine2"
msgstr "Your dome has just settled there, above the Trench."

msgid "openingListensTitle"
msgstr "The abyss listens"

msgid "openingListensLine1"
msgstr "The reef is narrow, and the abyss listens."

msgid "openingListensLine2"
msgstr "Every worksite, every recruit, every fight draws the creatures of the Trench."

msgid "openingCoreTitle"
msgstr "The Cold Core"

msgid "openingCoreLine1"
msgstr "Far below sleeps the Volcanic Core, the forge of the Ancients. Gone cold, it left the Trench to the monsters."

msgid "openingCoreLine2"
msgstr "Every colony wants to be the first to rekindle it."

msgid "openingGoalTitle"
msgstr "Your goal"

msgid "openingGoalLine1"
msgstr "Take a Rift, go down, cross a Vent and take the Core."

msgid "openingGoalLine2"
msgstr "Rekindle it up to its tenth fire before the rival colonies: tame the Volcano."
