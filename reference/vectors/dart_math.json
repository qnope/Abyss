{
 "api": {
  "abs": "a.abs(), a int; the smallest int is its own abs",
  "bits": "a + b, a - b, a * b (wrapping to 64 bits), a & b, a | b, a ^ b, -a, ~a, a.bitLength, a & -a (lowestBit), then with s = b.abs() % 64: a << s (shl), a >> s (shr, keeps the sign) and a >>> s (ushr, fills with zeros)",
  "clamp": "x.clamp(low, high): the operand it returns, so an int stays an int; throws (ArgumentError) when low > high",
  "divisionByZero": "a ~/ 0 and a % 0 throw (UnsupportedError), a int",
  "intDivision": "a ~/ b (truncDiv), a % b (modulo) and a.remainder(b), a and b int",
  "literals": "The double a literal or a constant expression of lib/domain stands for",
  "minMax": "min(a, b) and max(a, b) of dart:math: the operand they return, the first one for equal numbers of two types",
  "notFinite": "x.round(), x.floor(), x.ceil() and x.toInt() throw (UnsupportedError) for a NaN or an infinite x",
  "pow": "pow(base, exponent) of dart:math: a double as soon as an operand is one, an int for two ints and exponent >= 0. Only results a double holds exactly: the last bit of the others is the C library's (see the README)",
  "quotient": "q = a / b, a and b int: a double, never a whole division; then q.round(), q.floor() and q.ceil(), null when q is not finite",
  "rounding": "x.round() (half away from zero), x.floor(), x.ceil(), x.truncate() and x.toInt() of a double x: beyond 64 bits they give the nearest int"
 },
